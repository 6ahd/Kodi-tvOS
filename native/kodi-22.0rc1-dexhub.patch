+bool CTVOSNativeSkin::IsVisible() { return visible.load(); }
+bool CTVOSNativeSkin::ShouldRenderVideo() { return visible && suppressedOSD == WINDOW_DIALOG_VIDEO_OSD; }
+bool CTVOSNativeSkin::SuppressWindowDraw(int id) {
+  return visible && suppressedOSD != 0 && id != WINDOW_FULLSCREEN_VIDEO
+      && (id == WINDOW_DIALOG_VIDEO_OSD || id == suppressedWindow);
+}
+
+bool CTVOSNativeSkin::FrameMove() {
+  @autoreleasepool {
+  auto* gui = CServiceBroker::GetGUI();
+  if (!gui) { Hide(); return false; }
+  auto& manager = gui->GetWindowManager();
+  // Toasts and modeless Kodi dialogs must remain visible above the browse UI.
+  const int top = manager.GetTopmostDialog();
+  if (top != WINDOW_INVALID && top != manager.GetActiveWindowOrDialog()) { Hide(); return false; }
+  auto* window = manager.GetWindow(manager.GetActiveWindowOrDialog());
+  auto kind = window ? Property(window, "dexhub.native.kind") : std::string{};
+  auto* home = manager.GetWindow(WINDOW_HOME);
+  const bool enabled = home && Property(home, "dexhub.native.enabled") == "1";
+  const bool system = window && enabled && ((window->GetID() == WINDOW_DIALOG_VIDEO_OSD && Player()->IsPlayingVideo())
+    || window->GetID() == WINDOW_DIALOG_SELECT || window->GetID() == WINDOW_DIALOG_CONTEXT_MENU);
+  if (system) {
+    const auto session = Player()->IsPlayingVideo() ? PlaybackID() : std::string{};
+    if (systemWindow != window->GetID() || systemSession != session) {
+      systemWindow = window->GetID(); systemSession = session;
+      window->SetProperty("dexhub.native.instance", CVariant(Str(NSUUID.UUID.UUIDString)));
+    }
+    kind = window->GetID() == WINDOW_DIALOG_VIDEO_OSD ? "player" : "picker";
+    window->SetProperty("dexhub.native.rtl", home->GetProperty("dexhub.native.rtl"));
+  } else systemWindow = 0;
+  const bool supported = kind == "home" || kind == "details" || kind == "catalog" || kind == "sources" || kind == "source-loading" || kind == "options" || (kind == "player-settings" && Player()->IsPlayingVideo()) || (system && (kind == "player" || kind == "picker"));
+  if (!window || !supported || Property(window, "dexhub.native.instance").empty()) {
+    Hide(); return false;
+  }
+  const auto instance = Property(window, "dexhub.native.instance");
+  if (instance != renderedInstance) { Hide(); renderedInstance = instance; }
+  Deliver(window);
+  // A click may have opened Kodi's original sources, player or another dialog.
+  if (manager.GetActiveWindowOrDialog() != window->GetID()) { Hide(); return false; }
+  const auto now = std::chrono::steady_clock::now();
+  const bool floating = Player()->IsPlayingVideo() && manager.GetActiveWindow() == WINDOW_FULLSCREEN_VIDEO;
+  if (queued || now < nextSnapshot) return visible && !floating;
+  nextSnapshot = now + std::chrono::milliseconds(150);
+  NSData* data = Snapshot(window, kind);
+  if (!data) { Hide(); return false; }
+  if ([data isEqualToData:lastSnapshot]) return visible && !floating;
+  lastSnapshot = data; queued = true;
+  const auto expected = generation.load();
+  const int presentedWindowID = window->GetID();
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (generation != expected) { queued = false; return; }
+    Class renderer = NSClassFromString(@"DexNativeSkin");
+    if (!renderer) {
+      NSString* path = [NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Frameworks/DexNavigationKit.framework"];
+      [[NSBundle bundleWithPath:path] load]; renderer = NSClassFromString(@"DexNativeSkin");
+    }
+    const bool ready = renderer && [renderer respondsToSelector:@selector(update:from:perform:)];
+    if (ready && !visible)
+      [g_xbmcController.inputHandler.inputTouch cancelGestures:nil];
+    visible = ready && [renderer update:data from:g_xbmcController perform:^(NSString* event) {
+      if (generation == expected) QueueEvent(event);
+    }];
+    suppressedOSD = visible && floating ? WINDOW_DIALOG_VIDEO_OSD : 0;
+    suppressedWindow = visible && floating ? presentedWindowID : 0;
+    queued = false;
+  });
+  return visible && !floating;
+  }
+}
