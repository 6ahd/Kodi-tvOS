diff --git a/xbmc/platform/darwin/tvos/TVOSNativeSkin.mm b/xbmc/platform/darwin/tvos/TVOSNativeSkin.mm
new file mode 100644
index 0000000..ffc40b9
--- /dev/null
+++ b/xbmc/platform/darwin/tvos/TVOSNativeSkin.mm
@@ -0,0 +1,478 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "TVOSNativeSkin.h"
+#include "FileItem.h"
+#include "ServiceBroker.h"
+#include "TextureCache.h"
+#include "URL.h"
+#include "GUIInfoManager.h"
+#include "application/Application.h"
+#include "application/ApplicationComponents.h"
+#include "application/ApplicationPlayer.h"
+#include "guilib/GUIDialog.h"
+#include "filesystem/SpecialProtocol.h"
+#include "guilib/GUIBaseContainer.h"
+#include "guilib/GUIButtonControl.h"
+#include "guilib/GUIComponent.h"
+#include "guilib/GUIMessage.h"
+#include "guilib/GUIWindow.h"
+#include "guilib/GUIWindowManager.h"
+#include "guilib/WindowIDs.h"
+#include "guilib/guiinfo/GUIInfoLabels.h"
+#include "input/actions/Action.h"
+#include "input/actions/ActionIDs.h"
+#include "utils/Digest.h"
+#include "utils/Variant.h"
+#include "XBMCController.h"
+#import "input/LibInputHandler.h"
+#import "input/LibInputTouch.h"
+#import <UIKit/UIKit.h>
+#include <atomic>
+#include <chrono>
+#include <deque>
+#include <mutex>
+#include <cstdlib>
+#include <cmath>
+#include <vector>
+
+@interface NSObject (DexNativeSkinAPI)
++ (BOOL)update:(NSData*)data from:(UIViewController*)parent perform:(void (^)(NSString*))perform;
++ (void)suspend;
+@end
+
+namespace {
+std::atomic<bool> visible{false}, queued{false};
+std::atomic<unsigned long> generation{0};
+std::atomic<int> suppressedOSD{0};
+std::atomic<int> suppressedWindow{0};
+std::mutex eventLock;
+std::deque<NSDictionary*> events;
+unsigned long inputSerial = 0;
+NSData* lastSnapshot = nil;
+auto nextSnapshot = std::chrono::steady_clock::time_point{};
+int systemWindow = 0;
+std::string systemSession;
+std::string renderedInstance;
+
+NSString* NS(const std::string& value) { return [NSString stringWithUTF8String:value.c_str()] ?: @""; }
+std::string Str(NSString* value) { return [value isKindOfClass:NSString.class] ? std::string(value.UTF8String ?: "") : ""; }
+std::string Property(CGUIWindow* window, const char* name) { return window->GetProperty(name).asString(); }
+
+std::shared_ptr<CApplicationPlayer> Player() {
+  return CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+}
+
+std::string PlaybackID() {
+  auto* gui = CServiceBroker::GetGUI();
+  auto* home = gui->GetWindowManager().GetWindow(WINDOW_HOME);
+  const auto raw = home ? Property(home, "dexhub.session_v1") : std::string{};
+  NSData* data = [NS(raw) dataUsingEncoding:NSUTF8StringEncoding];
+  id session = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+  NSString* uid = [session isKindOfClass:NSDictionary.class] ? session[@"playback_uid"] : nil;
+  auto key = Str(uid);
+  if (key.empty()) key = gui->GetInfoManager().GetLabel(PLAYER_FILEPATH, WINDOW_FULLSCREEN_VIDEO) + gui->GetInfoManager().GetLabel(PLAYER_FILENAME, WINDOW_FULLSCREEN_VIDEO);
+  return KODI::UTILITY::CDigest::Calculate(KODI::UTILITY::CDigest::Type::SHA256, key + ":" + Player()->GetCurrentPlayer());
+}
+
+std::string Key(const std::shared_ptr<CGUIListItem>& item, int control, int index) {
+  if (!item) return {};
+  const auto file = std::dynamic_pointer_cast<CFileItem>(item);
+  std::string route = file ? file->GetPath() : std::string{};
+  if (route.empty()) route = item->GetProperty("key").asString() + ":" + item->GetLabel();
+  return KODI::UTILITY::CDigest::Calculate(KODI::UTILITY::CDigest::Type::SHA256,
+      std::to_string(control) + ":" + std::to_string(index) + ":" + route);
+}
+
+NSString* Art(const std::string& value) {
+  if (value.empty()) return @"";
+  if (value.front() == '/' || value.rfind("special://", 0) == 0)
+    return NS(CSpecialProtocol::TranslatePath(value));
+  if ((value.rfind("https://", 0) == 0 || value.rfind("http://", 0) == 0) && value.find('|') == std::string::npos)
+    return NS(value);
+  bool needsRecaching = false;
+  const auto cache = CServiceBroker::GetTextureCache();
+  auto cached = cache ? cache->CheckCachedImage(value, needsRecaching) : std::string{};
+  if (!cached.empty()) return NS(CSpecialProtocol::TranslatePath(cached));
+  CURL wrapped(value);
+  if (wrapped.IsProtocol("image")) {
+    auto inner = CURL::Decode(wrapped.GetHostName());
+    if ((inner.rfind("https://", 0) == 0 || inner.rfind("http://", 0) == 0) && inner.find('|') == std::string::npos)
+      return NS(inner);
+  }
+  // Keep provider headers and Kodi-specific image protocols in Kodi. The
+  // next snapshot can use the file after its original cache worker finishes.
+  if (cache) cache->BackgroundCacheImage(value);
+  return @"";
+}
+
+void QueueEvent(NSString* message) {
+  NSData* data = [message dataUsingEncoding:NSUTF8StringEncoding];
+  if (data.length > 4096) return;
+  id parsed = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+  if (![parsed isKindOfClass:NSDictionary.class]) return;
+  std::lock_guard lock(eventLock);
+  if ([parsed[@"kind"] isEqual:@"focus"] && !events.empty() && [events.back()[@"kind"] isEqual:@"focus"])
+    events.pop_back();
+  if (events.size() < 32) events.push_back(parsed);
+}
+
+bool Matches(CGUIWindow* window, NSDictionary* event) {
+  return window && [event[@"window"] intValue] == window->GetID()
+      && Str(event[@"instance"]) == Property(window, "dexhub.native.instance");
+}
+
+int Count(CGUIBaseContainer* list) {
+  return static_cast<int>(std::strtol(list->GetLabel(CONTAINER_NUM_ALL_ITEMS).c_str(), nullptr, 10));
+}
+
+void Deliver(CGUIWindow* window) {
+  std::deque<NSDictionary*> pending;
+  { std::lock_guard lock(eventLock); pending.swap(events); }
+  for (NSDictionary* event : pending) {
+    auto& manager = CServiceBroker::GetGUI()->GetWindowManager();
+    if (manager.GetActiveWindowOrDialog() != window->GetID() || !Matches(window, event)) continue;
+    const bool player = window->GetID() == WINDOW_DIALOG_VIDEO_OSD;
+    const bool playerSettings = Property(window, "dexhub.native.kind") == "player-settings";
+    if ((player || playerSettings) && (!Player()->IsPlayingVideo() || Str(event[@"session"]) != PlaybackID())) continue;
+    if (player) static_cast<CGUIDialog*>(window)->ResetAutoClose();
+    window->SetProperty("dexhub.native.input", CVariant(std::to_string(++inputSerial)));
+    NSString* kind = event[@"kind"];
+    if ([kind isEqual:@"seek"]) {
+      const double position = [event[@"position"] isKindOfClass:NSNumber.class] ? [event[@"position"] doubleValue] : -1;
+      if (player && Player()->CanSeek() && Player()->GetTotalTime() > 0 && std::isfinite(position) && position >= 0 && position <= Player()->GetTotalTime() / 1000.0)
+        Player()->SeekTime(static_cast<int64_t>(position * 1000));
+      continue;
+    }
+    if ([kind isEqual:@"back"]) { window->OnAction(CAction(ACTION_NAV_BACK)); continue; }
+    if ([kind isEqual:@"action"]) {
+      const int action = [event[@"action"] intValue];
+      if (action == ACTION_PLAYER_PLAY && player) g_application.OnAction(CAction(action));
+      else if (action == ACTION_MOVE_UP || action == ACTION_MOVE_DOWN || action == ACTION_PLAYER_PLAY)
+        window->OnAction(CAction(action));
+      if (!(playerSettings && (action == ACTION_MOVE_LEFT || action == ACTION_MOVE_RIGHT))) continue;
+    }
+    const int controlID = [event[@"control"] intValue], index = [event[@"index"] intValue];
+    auto* control = window->GetControl(controlID);
+    const bool sourceFilter = Property(window, "dexhub.native.kind") == "sources" && controlID == 2100;
+    const bool navigation = (controlID >= 9010 && controlID <= 9016) || (controlID >= 9050 && controlID <= 9056);
+    // Icon tabs deliberately hide their button while unfocused in the XML.
+    // They remain valid destinations through allowhiddenfocus.
+    if (!control || (!navigation && !sourceFilter && !control->IsVisible()) || (!sourceFilter && !control->CanFocus())) continue;
+    if (navigation && ((controlID >= 9050) != !Property(window, "dh.nav.names").empty())) continue;
+    if ((controlID == 9013 || controlID == 9053) && !Property(window, "dh.nav.noservers").empty()) continue;
+    if (auto* list = dynamic_cast<CGUIBaseContainer*>(control)) {
+      if (index < 0 || index >= Count(list)) continue;
+      const auto item = list->GetListItem(index, INFOFLAG_LISTITEM_ABSOLUTE);
+      if (Key(item, controlID, index) != Str(event[@"key"])) continue;
+      CGUIMessage select(GUI_MSG_ITEM_SELECT, window->GetID(), controlID, index);
+      window->OnMessage(select);
+      window->SetProperty("dexhub.native.control", CVariant(std::to_string(controlID)));
+      window->SetProperty("dexhub.native.index", CVariant(std::to_string(index)));
+    } else {
+      const auto key = "button:" + std::to_string(controlID);
+      if (key != Str(event[@"key"]) && !(player && controlID == 8200 && Str(event[@"key"]) == "timeline:" + PlaybackID())) continue;
+    }
+    if (!sourceFilter) {
+      CGUIMessage focus(GUI_MSG_SETFOCUS, window->GetID(), controlID);
+      window->OnMessage(focus);
+    }
+    if ([kind isEqual:@"action"] && playerSettings) {
+      auto* list = dynamic_cast<CGUIBaseContainer*>(control);
+      const auto item = list ? list->GetListItem(index, INFOFLAG_LISTITEM_ABSOLUTE) : nullptr;
+      if (item && ((controlID == 100 && item->GetProperty("adjust").asString() == "1") || (controlID == 210 && index == 0)))
+        window->OnAction(CAction([event[@"action"] intValue]));
+    } else if ([kind isEqual:@"click"]) {
+      // Execute the original control: lists notify Python, and real Kodi
+      // buttons also execute their skin-defined onclick actions exactly once.
+      // The subtitle service list intentionally handles Select in the
+      // original window's onAction rather than following its provider URL.
+      if (playerSettings && controlID == 300) window->OnAction(CAction(ACTION_SELECT_ITEM));
+      else control->OnAction(CAction(ACTION_SELECT_ITEM));
+    } else if ([kind isEqual:@"context"]) { window->OnAction(CAction(ACTION_CONTEXT_MENU)); }
+    else if (controlID == 2000 && Property(window, "dexhub.native.kind") == "sources") {
+      CGUIMessage input(GUI_MSG_CLICKED, 2998, window->GetID(), ACTION_SELECT_ITEM);
+      window->OnMessage(input);
+    }
+  }
+}
+
+void AddList(CGUIWindow* window, NSMutableArray* sections, int id, NSString* title, NSString* style, bool hidden = false) {
+  auto* list = dynamic_cast<CGUIBaseContainer*>(window->GetControl(id));
+  if (!list || (!hidden && (!list->IsVisible() || !list->CanFocus())) || Count(list) <= 0 || Count(list) > 2000) return;
+  NSMutableArray* cards = [NSMutableArray array];
+  for (int index = 0; index < Count(list); ++index) {
+    const auto item = list->GetListItem(static_cast<int>(index), INFOFLAG_LISTITEM_ABSOLUTE);
+    if (!item) return; // Kodi has not finished binding its layout yet.
+    auto image = item->GetArt("poster");
+    if ([style containsString:@"landscape"] || [style containsString:@"wide"]) image = item->GetArt("landscape");
+    if (image.empty()) image = item->GetArt("thumb");
+    if (image.empty()) image = item->GetProperty("icon").asString();
+    NSMutableArray* collage = [NSMutableArray array];
+    for (int n = 1; n <= 6; ++n) {
+      const auto poster = item->GetProperty("p" + std::to_string(n)).asString();
+      if (!poster.empty()) [collage addObject:Art(poster)];
+    }
+    auto label = item->GetLabel(), subtitle = item->GetLabel2();
+    NSMutableArray* badges = [NSMutableArray array];
+    if ([style isEqual:@"source"]) {
+      const auto name = item->GetProperty("name").asString();
+      if (!name.empty()) label = name;
+      subtitle = item->GetProperty("origin_line").asString();
+      image = item->GetProperty("provider_icon").asString();
+      for (const char* field : {"quality", "size_label", "provider", "fmt_compact_label", "source_type_label"}) {
+        const auto value = item->GetProperty(field).asString();
+        if (!value.empty()) [badges addObject:NS(value)];
+      }
+    }
+    const bool settings = Property(window, "dexhub.native.kind") == "player-settings";
+    if ([style isEqual:@"choice"] && subtitle.empty()) {
+      subtitle = item->GetProperty("hint").asString();
+      if (subtitle.empty()) subtitle = item->GetProperty("desc").asString();
+    }
+    [cards addObject:@{@"key":NS(Key(item, id, static_cast<int>(index))), @"control":@(id), @"index":@(index),
+      @"title":NS(label), @"subtitle":NS(subtitle), @"image":Art(image), @"badges":badges,
+      @"progress":@(item->GetProperty("progress").asDouble()), @"logo":Art(item->GetArt("clearlogo")),
+      @"rank":@(item->GetProperty("rank").asInteger()), @"collage":collage,
+      @"checked":@(item->IsSelected() || item->GetProperty("current").asString() == "1"),
+      @"adjustable":@(settings && ((id == 100 && item->GetProperty("adjust").asString() == "1") || (id == 210 && index == 0)))}];
+  }
+  [sections addObject:@{@"control":@(id), @"title":title ?: @"", @"style":style,
+    @"selected":@(list->GetSelectedItem()), @"items":cards}];
+}
+
+void AddButtons(CGUIWindow* window, NSMutableArray* sections, const std::vector<int>& ids, bool player = false, NSString* style = @"buttons") {
+  NSMutableArray* cards = [NSMutableArray array];
+  auto* home = CServiceBroker::GetGUI()->GetWindowManager().GetWindow(WINDOW_HOME);
+  const bool rtl = home && Property(home, "dexhub.native.rtl") == "1";
+  NSDictionary* labels = rtl ? @{@"sources":@"المصادر", @"episodes":@"الحلقات", @"info":@"المعلومات", @"audio":@"الصوت", @"subtitles":@"الترجمة", @"subsync":@"مزامنة الترجمة", @"nextsub":@"الترجمة التالية", @"external":@"مشغّل خارجي", @"video":@"إعدادات المشغّل", @"ppi":@"معلومات التشغيل"}
+    : @{@"sources":@"Sources", @"episodes":@"Episodes", @"info":@"Info", @"audio":@"Audio", @"subtitles":@"Subtitles", @"subsync":@"Subtitle sync", @"nextsub":@"Next subtitle", @"external":@"External player", @"video":@"Player settings", @"ppi":@"Playback info"};
+  NSDictionary* symbols = @{@"sources":@"square.stack", @"episodes":@"list.bullet", @"info":@"info.circle", @"audio":@"speaker.wave.2", @"subtitles":@"captions.bubble", @"subsync":@"arrow.triangle.2.circlepath", @"nextsub":@"captions.bubble", @"external":@"arrow.up.right.square", @"video":@"gearshape", @"ppi":@"chart.bar"};
+  for (int id : ids) {
+    auto* button = dynamic_cast<CGUIButtonControl*>(window->GetControl(id));
+    if (!button || !button->IsVisible() || !button->CanFocus()) continue;
+    NSString* label = NS(button->GetLabel()), *symbol = @"";
+    if (player) {
+      if (id >= 6501 && id <= 6510 && home) {
+        NSString* key = NS(Property(home, ("dhs.pref.osd_slot_" + std::to_string(id - 6500)).c_str()));
+        label = labels[key] ?: label; symbol = symbols[key] ?: @"";
+      } else if (id == 6001) { label = Player()->IsPaused() ? (rtl ? @"تشغيل" : @"Play") : (rtl ? @"إيقاف مؤقت" : @"Pause"); symbol = Player()->IsPaused() ? @"play.fill" : @"pause.fill"; }
+      else if (id == 6002) { label = rtl ? @"السابق" : @"Previous"; symbol = @"backward.end.fill"; }
+      else if (id == 6003) { label = rtl ? @"التالي" : @"Next"; symbol = @"forward.end.fill"; }
+      else if (id == 6004) { label = rtl ? @"إيقاف" : @"Stop"; symbol = @"stop.fill"; }
+    }
+    if (id == 2200) label = NS(Property(window, "play_mode_prefix") + ": " + Property(window, "play_mode_label"));
+    [cards addObject:@{@"key":NS("button:" + std::to_string(id)), @"control":@(id), @"index":@(cards.count),
+      @"title":label, @"subtitle":@"", @"image":@"", @"progress":@0, @"symbol":symbol}];
+  }
+  if (cards.count) [sections addObject:@{@"control":@0, @"title":@"", @"style":style, @"selected":@0, @"items":cards}];
+}
+
+NSData* Snapshot(CGUIWindow* window, const std::string& kind) {
+  NSMutableArray* sections = [NSMutableArray array];
+  if (kind == "home") {
+    NSMutableArray* navigation = [NSMutableArray array];
+    const bool names = !Property(window, "dh.nav.names").empty();
+    const int controls[] = {89,9010,9011,9012,9013,9014,9015,9016,9050,9051,9052,9053,9054,9055,9056,9020,9021};
+    const char* labels[] = {"home", "movie", "series", "servers", "live", "library", "addons"};
+    for (int id : controls) {
+      auto* button = dynamic_cast<CGUIButtonControl*>(window->GetControl(id));
+      const bool tab = (id >= 9010 && id <= 9016) || (id >= 9050 && id <= 9056);
+      if (!button || (!tab && !button->IsVisible()) || !button->CanFocus()) continue;
+      if (tab && ((id >= 9050) != names)) continue;
+      const int tabIndex = id - (names ? 9050 : 9010);
+      if (tab && tabIndex == 3 && !Property(window, "dh.nav.noservers").empty()) continue;
+      auto label = tab ? Property(window, (std::string("dh.nav.") + labels[tabIndex]).c_str()) : button->GetLabel();
+      if (id == 89 && label.empty()) label = Property(window, "dh.profile");
+      [navigation addObject:@{@"key":NS("button:" + std::to_string(id)), @"control":@(id), @"index":@(navigation.count),
+        @"title":NS(label), @"subtitle":@"", @"image":@"", @"progress":@0}];
+    }
+    // Direct buttons keep their real control ID; the section groups them visually.
+    NSMutableArray* iconSections = [NSMutableArray array];
+    AddList(window, iconSections, 89, @"", @"buttons");
+    AddList(window, iconSections, 91, @"", @"buttons");
+    for (NSDictionary* icons in iconSections) [navigation addObjectsFromArray:icons[@"items"]];
+    if (navigation.count) [sections addObject:@{@"control":@90, @"title":@"", @"style":@"buttons", @"selected":@0, @"items":navigation}];
+    AddList(window, sections, 92, @"", @"buttons");
+    AddList(window, sections, 200, @"", @"buttons");
+    AddList(window, sections, 210, @"", @"buttons");
+    NSMutableArray* tools = [NSMutableArray array];
+    for (int id : {93, 6009, 94, 96, 97}) {
+      auto* button = dynamic_cast<CGUIButtonControl*>(window->GetControl(id));
+      if (!button || !button->IsVisible() || !button->CanFocus()) continue;
+      [tools addObject:@{@"key":NS("button:" + std::to_string(id)), @"control":@(id), @"index":@(tools.count),
+        @"title":NS(button->GetLabel()), @"subtitle":@"", @"image":@"", @"progress":@0}];
+    }
+    if (tools.count) [sections addObject:@{@"control":@90, @"title":@"", @"style":@"buttons", @"selected":@0, @"items":tools}];
+    for (int id = 5000; id <= 5005; ++id)
+      AddList(window, sections, id, NS(Property(window, "dh.rowA.title")), id == 5001 || id == 5003 ? @"landscape" : id == 5002 || id == 5005 ? @"square" : @"poster");
+  } else if (kind == "details") {
+    AddList(window, sections, 100, @"", @"buttons");
+    AddList(window, sections, 300, @"", @"buttons");
+    AddList(window, sections, 310, NS(Property(window, "dd.eps.status")), @"landscape");
+    AddList(window, sections, 400, NS(Property(window, "dd.cast.title")), @"square");
+    AddList(window, sections, 500, NS(Property(window, "dd.related.title")), @"poster");
+  } else if (kind == "catalog") {
+    AddList(window, sections, 6100, @"", @"buttons"); // Original sort/genre/filter actions.
+    AddList(window, sections, 6110, @"", @"buttons"); // Original open filter sheet.
+    for (int id = 6000; id <= 6002; ++id)
+      AddList(window, sections, id, @"", id == 6001 ? @"grid-landscape" : id == 6002 ? @"grid-square" : @"grid-poster");
+  } else if (kind == "sources") {
+    AddButtons(window, sections, {2200});
+    AddList(window, sections, 2300, @"", @"buttons");
+    AddList(window, sections, 2100, @"", @"buttons", true);
+    AddList(window, sections, 2000, NS(Property(window, "results_label") + "  " + Property(window, "total_results")), @"source");
+  } else if (kind == "source-loading") {
+    AddButtons(window, sections, {9001, 9002, 9000});
+  } else if (kind == "options") {
+    AddList(window, sections, 100, @"", @"choice");
+  } else if (kind == "player-settings") {
+    if (Property(window, "side").empty()) AddList(window, sections, 100, @"", @"choice");
+    else if (Property(window, "side") == "tracks") AddList(window, sections, 200, @"", @"choice");
+    else {
+      AddList(window, sections, 210, @"", @"choice");
+      AddList(window, sections, Property(window, "src") == "kodi" ? 300 : 220, @"", @"choice");
+    }
+  } else if (kind == "player") {
+    const auto session = PlaybackID();
+    [sections addObject:@{@"control":@8200, @"title":@"", @"style":@"timeline", @"selected":@0,
+      @"items":@[@{@"key":NS("timeline:" + session), @"control":@8200, @"index":@0,
+      @"title":@"", @"subtitle":@"", @"image":@"", @"progress":@0}]}];
+    AddButtons(window, sections, {6001, 6002, 6003, 6004}, true);
+    AddButtons(window, sections, {6501,6502,6503,6504,6505,6506,6507,6508,6509,6510}, true);
+  } else if (kind == "picker") {
+    if (window->GetID() == WINDOW_DIALOG_SELECT) {
+      AddList(window, sections, 3, @"", @"choice"); AddList(window, sections, 6, @"", @"choice");
+      AddButtons(window, sections, {5,8,7});
+    } else {
+      std::vector<int> choices; for (int id = 1000; id <= 1100; ++id) choices.push_back(id);
+      // Context choices are still real Kodi controls, in their original order.
+      AddButtons(window, sections, choices, false, @"choice");
+    }
+  }
+  if (!sections.count) return nil;
+  auto title = Property(window, "dh.title");
+  if (title.empty()) title = Property(window, "dh.page.title");
+  auto background = Property(window, "dh.backdrop");
+  if (background.empty()) background = Property(window, "dh.brand.fanart");
+  auto logo = Property(window, "dh.logo"), plot = Property(window, "dh.plot"), info = Property(window, "dh.meta");
+  auto heroKey = Property(window, "dexhub.native.hero");
+  std::string status;
+  if (kind == "sources") {
+    title = Property(window, "nv_title"); if (title.empty()) title = Property(window, "title");
+    background = Property(window, "dexhub.results.fanart"); logo = Property(window, "dexhub.results.clearlogo");
+    plot = Property(window, "plot"); info = Property(window, "nv_l1") + "  " + Property(window, "nv_l2");
+    status = Property(window, "loading_label"); if (info.empty() || info == "  ") info = status;
+  } else if (kind == "source-loading") {
+    title = Property(window, "title"); if (title.empty()) title = Property(window, "eyebrow");
+    background = Property(window, "dexhub.loading.fanart"); logo = Property(window, "dexhub.loading.clearlogo");
+    info = Property(window, "status"); status = Property(window, "progress_label");
+    info += "  " + status;
+    plot = Property(window, "hint_line") + "  " + Property(window, "current_provider");
+  } else if (kind == "options") {
+    title = Property(window, "do.title"); status = Property(window, "do.subtitle");
+  } else if (kind == "player-settings") {
+    const bool side = !Property(window, "side").empty();
+    title = Property(window, side ? "side_title" : "title"); status = Property(window, side ? "side_hint" : "hint");
+  } else if (kind == "player") {
+    title = CServiceBroker::GetGUI()->GetInfoManager().GetLabel(VIDEOPLAYER_TITLE, WINDOW_FULLSCREEN_VIDEO);
+    status = Player()->GetCurrentPlayer();
+  } else if (kind == "picker") {
+    const auto* heading = window->GetControl(1); title = heading ? heading->GetDescription() : "";
+  }
+  if (heroKey.empty()) heroKey = Property(window, "dexhub.native.instance");
+  NSString* focusKey = @"";
+  const int focused = window->GetFocusedControlID();
+  auto* focusedList = dynamic_cast<CGUIBaseContainer*>(window->GetControl(focused));
+  for (NSDictionary* section in sections)
+    for (NSDictionary* card in section[@"items"])
+      if ([card[@"control"] intValue] == focused && (!focusedList || [card[@"index"] intValue] == focusedList->GetSelectedItem()))
+        focusKey = card[@"key"];
+  NSMutableDictionary* model = [@{@"api":@2, @"window":@(window->GetID()), @"instance":NS(Property(window,"dexhub.native.instance")),
+    @"kind":NS(kind == "options" || kind == "player-settings" ? "picker" : kind), @"title":NS(title), @"logo":Art(logo), @"background":Art(background),
+    @"plot":NS(Property(window,"dh.plot.off").empty() ? plot : ""), @"info":NS(info), @"heroKey":NS(heroKey), @"status":NS(status),
+    @"caption":NS(Property(window,"dh.cards.below")),
+    @"rtl":@(Property(window,"dexhub.native.rtl") == "1"), @"motion":@(Property(window,"dh.motion") != "none"),
+    @"focused":@(focused), @"focusKey":focusKey, @"sections":sections} mutableCopy];
+  if (kind == "player" || kind == "player-settings") model[@"playback"] = @{@"session":NS(PlaybackID()), @"time":@(std::max<int64_t>(0, Player()->GetTime()) / 1000.0),
+    @"duration":@(std::max<int64_t>(0, Player()->GetTotalTime()) / 1000.0), @"paused":@(Player()->IsPaused()), @"buffering":@(Player()->IsCaching()), @"canSeek":@(Player()->CanSeek())};
+  return [NSJSONSerialization dataWithJSONObject:model options:NSJSONWritingSortedKeys error:nil];
+}
+
+void Hide() {
+  if (!visible.exchange(false) && !queued) return;
+  ++generation; lastSnapshot = nil;
+  suppressedOSD = 0;
+  suppressedWindow = 0;
+  { std::lock_guard lock(eventLock); events.clear(); }
+  dispatch_async(dispatch_get_main_queue(), ^{ [NSClassFromString(@"DexNativeSkin") suspend]; });
+}
