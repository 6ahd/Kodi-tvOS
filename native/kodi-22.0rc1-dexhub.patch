diff --git a/xbmc/platform/darwin/tvos/TVOSNativeHome.mm b/xbmc/platform/darwin/tvos/TVOSNativeHome.mm
new file mode 100644
index 0000000..3ff490f
--- /dev/null
+++ b/xbmc/platform/darwin/tvos/TVOSNativeHome.mm
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "TVOSNativeHome.h"
+
+#include "LangInfo.h"
+#include "ServiceBroker.h"
+#include "XBMCController.h"
+#include "application/Application.h"
+#include "application/ApplicationComponents.h"
+#include "application/ApplicationPlayer.h"
+#include "application/ApplicationPowerHandling.h"
+#include "filesystem/SpecialProtocol.h"
+#include "guilib/GUIComponent.h"
+#include "guilib/GUIWindow.h"
+#include "guilib/GUIWindowManager.h"
+#include "guilib/WindowIDs.h"
+#include "messaging/ApplicationMessenger.h"
+#include "utils/Variant.h"
+#include "utils/log.h"
+
+#import <Foundation/Foundation.h>
+#import <UIKit/UIKit.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <mutex>
+
+@interface NSObject (DexNativeHomeAPI)
++ (void)suspend;
++ (BOOL)presentFrom:(UIViewController*)parent
+       profileRoot:(NSString*)profileRoot
+          artRoots:(NSDictionary*)artRoots
+          language:(NSString*)language
+           perform:(void (^)(NSString*))perform;
+@end
+
+namespace
+{
+enum class Mode { Waiting, Queued, Visible, Handoff, Kodi };
+std::atomic<Mode> mode{Mode::Waiting};
+std::atomic<unsigned int> handoffs{0};
+std::atomic<bool> activity{false};
+std::atomic<bool> viewportDirty{false};
+std::mutex viewportLock;
+std::string viewportTab{"all"}, viewportRow;
+
+NSString* NS(const std::string& text) { return [NSString stringWithUTF8String:text.c_str()]; }
+
+void Perform(NSString* json)
+{
+  NSData* data = [json dataUsingEncoding:NSUTF8StringEncoding];
+  id parsed = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+  if (![parsed isKindOfClass:[NSDictionary class]])
+  {
+    mode = Mode::Kodi;
+    return;
+  }
+  NSString* kind = parsed[@"kind"];
+  NSString* path = parsed[@"path"];
+  if ([kind isEqualToString:@"viewport"])
+  {
+    if (![path isKindOfClass:[NSString class]])
+      return;
+    NSRange separator = [path rangeOfString:@":"];
+    if (separator.location == NSNotFound)
+      return;
+    NSString* tab = [path substringToIndex:separator.location];
+    if (![@[@"all", @"movie", @"series", @"library", @"servers"] containsObject:tab])
+      return;
+    {
+      std::lock_guard lock(viewportLock);
+      viewportTab = tab.UTF8String;
+      viewportRow = [path substringFromIndex:separator.location + 1].UTF8String;
+    }
+    viewportDirty = true;
+    return;
+  }
+  if ([kind isEqualToString:@"activity"])
+  {
+    activity = true;
+    return;
+  }
+  mode = Mode::Handoff;
+  [g_xbmcController resumeAnimation];
+  if ([kind isEqualToString:@"kodi"])
+  {
+    mode = Mode::Kodi;
+    return;
+  }
+  if (![path isKindOfClass:[NSString class]] || path.length == 0)
+  {
+    mode = Mode::Kodi;
+    return;
+  }
+  const bool folder = [kind isEqualToString:@"folder"];
+  const bool play = [kind isEqualToString:@"play"];
+  const bool run = [kind isEqualToString:@"run"];
+  NSString* scheme = [[path componentsSeparatedByString:@":"] firstObject].lowercaseString;
+  const bool mediaPath = [@[@"http", @"https", @"plugin", @"file", @"smb", @"nfs",
+                           @"special", @"videodb", @"musicdb", @"stack"] containsObject:scheme] ||
+      [path hasPrefix:@"/"];
+  if ((!folder && !play && !run) ||
+      (run && ![path hasPrefix:@"plugin://plugin.video.dexhub.tvos/"]) ||
+      ((play || folder) && !mediaPath))
+  {
+    mode = Mode::Kodi;
+    return;
+  }
+  NSString* escaped = [path stringByReplacingOccurrencesOfString:@"\"" withString:@"%22"];
+  const bool homeFolder = [path containsString:@"action=skin_folder"];
+  NSString* command = play ? [NSString stringWithFormat:@"PlayMedia(\"%@\")", escaped]
+      : folder && !homeFolder ? [NSString stringWithFormat:@"ActivateWindow(Videos,\"%@\",return)", escaped]
+      : [NSString stringWithFormat:@"RunPlugin(\"%@\")", escaped];
+  handoffs.fetch_add(1);
+  mode = Mode::Handoff;
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_EXECUTE_BUILT_IN, 0, 0, nullptr,
+                                             std::string(command.UTF8String));
+}
+
+void Present()
+{
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (mode != Mode::Queued)
+      return;
+    if (UIApplication.sharedApplication.applicationState != UIApplicationStateActive ||
+        g_xbmcController.presentedViewController || !g_xbmcController.view.window)
+    {
+      mode = Mode::Waiting;
+      return;
+    }
+    Class ui = NSClassFromString(@"DexNativeHome");
+    if (!ui)
+    {
+      NSString* path = [NSBundle.mainBundle.privateFrameworksPath
+          stringByAppendingPathComponent:@"DexAetherBridge.framework"];
+      NSError* error = nil;
+      if (![[NSBundle bundleWithPath:path] loadAndReturnError:&error])
+      {
+        CLog::Log(LOGERROR, "Dex native Home: UI framework could not be loaded");
+        mode = Mode::Kodi;
+        return;
+      }
+      ui = NSClassFromString(@"DexNativeHome");
+    }
+    if (![ui respondsToSelector:@selector(presentFrom:profileRoot:artRoots:language:perform:)])
+    {
+      mode = Mode::Kodi;
+      return;
+    }
+    NSMutableDictionary* roots = [NSMutableDictionary dictionary];
+    for (const char* prefix : {"special://home/", "special://xbmc/", "special://profile/", "special://temp/"})
+      roots[NS(prefix)] = NS(CSpecialProtocol::TranslatePath(prefix));
+    NSString* profile = NS(CSpecialProtocol::TranslatePath(
+        "special://profile/addon_data/plugin.video.dexhub.tvos/"));
+    mode = Mode::Visible;
+    BOOL shown = [ui presentFrom:g_xbmcController profileRoot:profile artRoots:roots
+                        language:NS(g_langInfo.GetEnglishLanguageName())
+                         perform:^(NSString* command) { Perform(command); }];
+    if (!shown)
+      mode = Mode::Waiting;
+    // Full-screen presentation pauses Kodi's GUI through viewWillDisappear.
+    // Its event loop and add-on workers continue while UIKit owns navigation.
+  });
+}
+}
+
+void CTVOSNativeHome::FrameMove()
+{
+  if (!g_application.IsInitialized())
+    return;
+  auto* gui = CServiceBroker::GetGUI();
+  if (!gui)
+    return;
+  auto& windows = gui->GetWindowManager();
+  auto* home = windows.GetWindow(WINDOW_HOME);
+  if (home && viewportDirty.exchange(false))
+  {
+    std::string tab, row;
+    {
+      std::lock_guard lock(viewportLock);
+      tab = viewportTab;
+      row = viewportRow;
+    }
+    home->SetProperty("dhs.tab", CVariant(tab));
+    int slot = 1;
+    for (int n = 1; n <= 20 && !row.empty(); ++n)
+      if (home->GetProperty("dhs." + tab + "." + std::to_string(n) + ".id").asString() == row)
+      {
+        slot = n;
+        break;
+      }
+    home->SetProperty("dhs.fr", CVariant(std::to_string(slot)));
+  }
+  static Mode marked = Mode::Kodi;
+  const Mode current = mode.load();
+  if (home && current != marked)
+  {
+    if (current == Mode::Visible || current == Mode::Queued)
+      home->SetProperty("dexhub.native.active", CVariant("1"));
+    else
+      home->SetProperty("dexhub.native.active", CVariant(""));
+    marked = current;
+  }
+  if (mode == Mode::Visible)
+  {
+    const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+    const bool trailer = home && !home->GetProperty("dexhub.trailer.active").asString().empty();
+    static auto lastTrailerStop = std::chrono::steady_clock::time_point::min();
+    const auto now = std::chrono::steady_clock::now();
+    if (trailer && player->IsPlaying() && now > lastTrailerStop)
+    {
+      lastTrailerStop = now + std::chrono::seconds(1);
+      CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_STOP);
+    }
+    if (player->IsPlaying() && !trailer)
+    {
+      handoffs.fetch_add(1);
+      mode = Mode::Handoff;
+      dispatch_async(dispatch_get_main_queue(), ^{
+        [NSClassFromString(@"DexNativeHome") suspend];
+        [g_xbmcController resumeAnimation];
+      });
+      return;
+    }
+    const auto power = CServiceBroker::GetAppComponents().GetComponent<CApplicationPowerHandling>();
+    if (power->GetRenderGUI())
+      power->SetRenderGUI(false);
+  }
+  if (activity.exchange(false))
+  {
+    const auto power = CServiceBroker::GetAppComponents().GetComponent<CApplicationPowerHandling>();
+    power->ResetSystemIdleTimer();
+    power->ResetScreenSaver();
+  }
+  static const bool enabled = !std::getenv("DEX_NATIVE_HOME") ||
+      std::string(std::getenv("DEX_NATIVE_HOME")) != "0";
+  if (!enabled || mode == Mode::Visible || mode == Mode::Queued || mode == Mode::Kodi)
+    return;
+  const auto now = std::chrono::steady_clock::now();
+  static auto next = now;
+  if (now < next)
+    return;
+  next = now + std::chrono::milliseconds(500);
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  const bool trailer = home && !home->GetProperty("dexhub.trailer.active").asString().empty();
+  const bool atHome = windows.GetActiveWindow() == WINDOW_HOME &&
+      !windows.HasVisibleModalDialog() && (!player->IsPlaying() || trailer);
+  static unsigned int observedHandoff = 0;
+  static bool sawOtherScreen = false;
+  if (mode == Mode::Handoff)
+  {
+    if (observedHandoff != handoffs.load())
+    {
+      observedHandoff = handoffs.load();
+      sawOtherScreen = false;
+    }
+    if (!atHome)
+      sawOtherScreen = true;
+    if (!sawOtherScreen)
+      return;
+  }
+  if (!atHome || !home || home->GetProperty("dhs.ready").asString().empty())
+    return;
+  mode = Mode::Queued;
+  home->SetProperty("dexhub.native.active", CVariant("1"));
+  if (trailer && player->IsPlaying())
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_STOP);
+  Present();
+}
