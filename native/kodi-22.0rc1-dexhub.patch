diff --git a/xbmc/guilib/DexListAppend.h b/xbmc/guilib/DexListAppend.h
new file mode 100644
index 0000000..e1bf4aa
--- /dev/null
+++ b/xbmc/guilib/DexListAppend.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+
+namespace DEXHUB
+{
+// Python sends the complete list even when it only adds a page. Reuse the
+// existing objects (and their focused layouts/textures) for a strict append.
+// Equal labels/paths are insufficient: replacements must still rebind.
+template<class Existing, class Incoming>
+bool AppendUnchangedPrefix(Existing& existing, const Incoming& incoming)
+{
+  if (existing.empty() || incoming.size() <= existing.size() ||
+      !std::equal(existing.begin(), existing.end(), incoming.begin()))
+    return false;
+
+  existing.insert(existing.end(), incoming.begin() + existing.size(), incoming.end());
+  return true;
+}
+
+template<class Snapshot>
+void DetachListSnapshot(Snapshot& snapshot)
+{
+  // CFileItemList's destructor frees shared item layouts. Remove() drops only
+  // its references, leaving the live container's layouts and textures intact.
+  for (int i = snapshot.Size(); i > 0; --i)
+    snapshot.Remove(i - 1);
+}
+} // namespace DEXHUB
