new file mode 100644
index 0000000..eff4d3b
--- /dev/null
+++ b/xbmc/platform/darwin/tvos/input/DexRemoteNavigation.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#import <Foundation/Foundation.h>
+
+@protocol DexRemoteNavigationAPI <NSObject>
+- (void)beginIgnoring:(BOOL)ignore context:(NSInteger)context;
+- (NSInteger)moveX:(double)x y:(double)y time:(double)time horizontal:(NSInteger)horizontal
+          vertical:(NSInteger)vertical context:(NSInteger)context;
+- (NSInteger)endX:(double)x y:(double)y time:(double)time horizontal:(NSInteger)horizontal
+         vertical:(NSInteger)vertical context:(NSInteger)context;
+- (void)resetGesture;
+- (BOOL)acceptsContext:(NSInteger)context;
+@end
+
+static inline id<DexRemoteNavigationAPI> DexCreateRemoteNavigation()
+{
+  Class navigation = NSClassFromString(@"DexRemoteNavigation");
+  if (!navigation)
+  {
+    NSString* path = [NSBundle.mainBundle.privateFrameworksPath
+        stringByAppendingPathComponent:@"DexNavigationKit.framework"];
+    [[NSBundle bundleWithPath:path] load];
+    navigation = NSClassFromString(@"DexRemoteNavigation");
+  }
+  if (![navigation instancesRespondToSelector:@selector(beginIgnoring:context:)] ||
+      ![navigation instancesRespondToSelector:@selector(moveX:y:time:horizontal:vertical:context:)] ||
+      ![navigation instancesRespondToSelector:@selector(endX:y:time:horizontal:vertical:context:)] ||
+      ![navigation instancesRespondToSelector:@selector(resetGesture)] ||
+      ![navigation instancesRespondToSelector:@selector(acceptsContext:)])
+    return nil;
+  return (id<DexRemoteNavigationAPI>)[navigation new];
+}
diff --git a/xbmc/platform/darwin/tvos/input/DexRemotePan.h b/xbmc/platform/darwin/tvos/input/DexRemotePan.h
new file mode 100644
index 0000000..1448954
--- /dev/null
+++ b/xbmc/platform/darwin/tvos/input/DexRemotePan.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+class DexRemotePan
+{
+public:
+  void Begin(bool ignore)
+  {
+    Reset();
+    m_active = true;
+    m_ignore = ignore;
+  }
+
+  int Move(double x, double y, double now, int horizontalSensitivity, int verticalSensitivity)
+  {
+    if (!m_active || m_ignore)
+      return 0;
+    const double horizontal = Threshold(horizontalSensitivity);
+    const double vertical = Threshold(verticalSensitivity);
+    if (m_axis == Axis::None)
+    {
+      if (std::abs(x) >= horizontal && std::abs(x) >= std::abs(y))
+        m_axis = Axis::Horizontal;
+      else if (std::abs(y) >= vertical && std::abs(y) > std::abs(x))
+        m_axis = Axis::Vertical;
+      else
+        return 0;
+    }
+    const bool across = m_axis == Axis::Horizontal;
+    const double delta = across ? x - m_x : y - m_y;
+    if (std::abs(delta) < (across ? horizontal : vertical))
+      return 0;
+    // Discard distance during the repeat interval; never replay a fast fling.
+    m_x = x;
+    m_y = y;
+    if (m_sent && now - m_last < (across ? 0.14 : 0.20))
+      return 0;
+    m_sent = true;
+    m_last = now;
+    return across ? (delta < 0 ? 25 : 26) : (delta < 0 ? 23 : 24);
+  }
+
+  int End(double x, double y, double now, int horizontalSensitivity, int verticalSensitivity)
+  {
+    const int key = m_sent ? 0 : Move(x, y, now, horizontalSensitivity, verticalSensitivity);
+    Reset();
+    return key;
+  }
+
+  void Reset()
+  {
+    m_axis = Axis::None;
+    m_active = m_ignore = m_sent = false;
+    m_x = m_y = m_last = 0;
+  }
+
+private:
+  static double Threshold(int sensitivity)
+  {
+    return std::clamp((1500.0 - std::clamp(sensitivity, 50, 1450)) * 0.12, 36.0, 174.0);
+  }
+  enum class Axis { None, Horizontal, Vertical };
+  Axis m_axis{Axis::None};
+  bool m_active{false}, m_ignore{false}, m_sent{false};
+  double m_x{0}, m_y{0}, m_last{0};
+};
